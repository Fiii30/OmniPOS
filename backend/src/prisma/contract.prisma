// use prisma-8

enum Role {
  ADMIN
  STAFF
}

enum PaymentMethod {
  QRIS
  TRANSFER_BANK
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  PAID
  CANCEL_REQUESTED
  CANCELLED
}

enum StockFlowType {
  IN
  OUT
  ADJUSTMENT
  RETURN
}

model User {
  id        String   @id @onCreate(cuid(2))
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STAFF)
  isActive  Boolean  @default(true)
  createdAt DateTime @onCreate(now())
  updatedAt DateTime @onCreate(now()) @onUpdate(now())
  statusHistories OrderStatusHistory[]
  stockFlows      StockFlow[]

  @@map("users")
}

model Product {
  id String @id @onCreate(cuid(2))
  name String
  price Int
  stock Int
  isActive Boolean @default(true)
  createdAt DateTime @onCreate(now())
  updatedAt DateTime @onCreate(now()) @onUpdate(now())
  stockFlows StockFlow[]

  @@map("products")
}

model Order {
  id        String   @id @onCreate(cuid(2))
  userId    String
  total     Int
  createdAt DateTime @onCreate(now())
  updatedAt DateTime @onCreate(now()) @onUpdate(now())

  status OrderStatus @default(PENDING)

  payments        Payment[]
  statusHistories OrderStatusHistory[]
  stockFlows      StockFlow[]
  // Order ini dibuat oleh user tertentu.
  user User @relation(fields: [userId], references: [id])


  // Satu order bisa memiliki banyak order item.
  items OrderItem[]


  @@map("orders")
}


model OrderItem {
  id          String   @id @onCreate(cuid(2))
  orderId     String
  productId   String
  productName String
  price       Int
  quantity    Int
  subtotal    Int
  createdAt   DateTime @onCreate(now())
  updatedAt   DateTime @onCreate(now()) @onUpdate(now())


  // Order item ini milik satu order.
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)


  // Order item ini merujuk ke satu produk.
  product Product @relation(fields: [productId], references: [id])


  @@map("order_items")
}

model Payment {
  id            String        @id @onCreate(uuid())
  orderId       String
  method        PaymentMethod
  amount        Int
  changeAmount  Int           @default(0)
  status        PaymentStatus @default(PENDING)
  referenceCode String?
  paidAt        DateTime?
  createdAt     DateTime      @onCreate(now())
  updatedAt     temporal.UpdatedAt

  order Order @relation(fields: [orderId], references: [id])

  statusHistories OrderStatusHistory[]

  @@index([orderId])
}

model OrderStatusHistory {
  id             String       @id @onCreate(uuid())
  orderId        String
  paymentId      String?
  previousStatus OrderStatus
  newStatus      OrderStatus
  changedById    String
  reason         String?
  createdAt      DateTime     @onCreate(now())

  order   Order    @relation(fields: [orderId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])
  changedBy User   @relation(fields: [changedById], references: [id])

  @@index([orderId])
}

model StockFlow {
  id          String        @id @onCreate(uuid())
  productId   String
  orderId     String?
  type        StockFlowType
  quantity    Int
  stockBefore Int
  stockAfter  Int
  changedById String
  note        String?
  createdAt   DateTime      @onCreate(now())

  product   Product  @relation(fields: [productId], references: [id])
  order     Order?   @relation(fields: [orderId], references: [id])
  changedBy User     @relation(fields: [changedById], references: [id])

  @@index([productId])
  @@index([orderId])
}